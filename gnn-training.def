# GPU / PyTorch — training, word2vec, and full pipeline steps that need torch & PyG.
#
# Build (from repo root):
#   apptainer build gnn-training.sif gnn-training.def
#
# Run from repo root (CWD visible at same path; add --nv when using GPU):
#   apptainer exec --nv gnn-training.sif bash -lc 'export PYTHONPATH="${PWD}/src" && python -m graph.train --help'

Bootstrap: docker
From: nvidia/cuda:12.5.1-cudnn-devel-ubuntu22.04

# Staged pip inputs live under /root, not /tmp: Apptainer bind-mounts /dev/shm over /tmp during %post.
%files
    gnn-requirements.txt /root/gnn-pip/requirements.txt
    gnn-extra-requirements.txt /root/gnn-pip/extra-requirements.txt

%post
    /bin/bash <<'CHEETAH_GNN_TRAINPOST'
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    mkdir -p /root/apt-tmp
    export TMPDIR=/root/apt-tmp
    # Apptainer %post: /var (and often /root subpaths) are overlay — apt's partial→final .deb rename
    # hits EBUSY. /tmp is tmpfs here; _apt cannot read /root (0700), so archives must not live under /root.
    mkdir -p /tmp/apt-archives/partial
    cat >/etc/apt/apt.conf.d/99cheetah-apptainer.conf <<'EOF'
Dir::Cache::archives "/tmp/apt-archives";
APT::Sandbox::User "root";
EOF

    # --- versions (keep in sync with gnn-preprocessing.def where shared) ---
    readonly PYTHON_VERSION=3.11.9
    readonly TZ=Europe/Berlin

    ln -snf "/usr/share/zoneinfo/${TZ}" /etc/localtime && echo "${TZ}" > /etc/timezone

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git locales time unzip wget zip

    mkdir -p /usr/share/man/man1
    apt-get install -y --no-install-recommends \
        build-essential gfortran libbz2-dev libc6-dev libffi-dev libgdbm-dev \
        libgraphviz-dev libncursesw5-dev libpq-dev libreadline-dev libsqlite3-dev \
        libssl-dev tar tk-dev zlib1g-dev \
        p7zip-full software-properties-common wget

    # --- Python (source build) ---
    cd /
    wget -q "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz"
    tar -xf "Python-${PYTHON_VERSION}.tar.xz"
    cd "Python-${PYTHON_VERSION}"
    ./configure --enable-optimizations
    make -j "$(nproc)"
    make install
    ln -sf /usr/local/bin/python3 /usr/bin/python
    ln -sf /usr/local/bin/pip3 /usr/bin/pip
    cd /
    rm -rf "Python-${PYTHON_VERSION}" "Python-${PYTHON_VERSION}.tar.xz"

    pip install --no-cache-dir --upgrade pip setuptools wheel

    # --- Python venv (training stack, baked into SIF) ---
    python -m venv /opt/gnn-training-venv
    # shellcheck disable=SC1091
    source /opt/gnn-training-venv/bin/activate
    pip install --no-cache-dir -r /root/gnn-pip/requirements.txt
    pip install --no-cache-dir -r /root/gnn-pip/extra-requirements.txt
    deactivate || true
    rm -rf /root/gnn-pip
    rm -rf /root/apt-tmp /tmp/apt-archives

    apt-get clean
    rm -rf /var/lib/apt/lists/*
CHEETAH_GNN_TRAINPOST

%environment
    export TZ=Europe/Berlin
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PATH="/opt/gnn-training-venv/bin:${PATH}"

%runscript
    exec "$@"
